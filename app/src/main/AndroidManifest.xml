<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The whole product: an always-on microphone. RECORD_AUDIO is a runtime
         permission; the foreground-service pair is what lets it keep running
         with the screen off. INTERNET is needed once by Porcupine to validate
         the AccessKey (and later to train custom phrases); inference is offline. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The lock screen is a window drawn over other apps; "display over other
         apps" is granted from Settings, not a runtime dialog. VIBRATE is a
         normal permission for find-phone. No CAMERA (setTorchMode does not need
         it) and no ACCESS_NOTIFICATION_POLICY (alarms are DND-exempt by default). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType="microphone" is mandatory on Android 14+ for a
             service that records audio; Play also requires a matching Console
             declaration (plan, Milestone 8). -->
        <!-- Device Admin: force-lock only, so DevicePolicyManager.lockNow() is
             legal for us. See res/xml/device_admin.xml. -->
        <receiver
            android:name=".LockDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
